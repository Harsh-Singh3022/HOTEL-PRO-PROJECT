# ==============================================================================
# HotelPro Root .gitignore
# Prevents sensitive credentials, binaries, caches, and node_modules from leak
# ==============================================================================

# Environment files & Secrets
.env
.env.*
*.env
server/.env
server/.env.*
client/.env
client/.env.*
!.env.example
!server/.env.example
!client/.env.example

# Dependencies
node_modules/
*/node_modules/
package-lock.json.backup

# Production builds
dist/
build/
client/dist/

# Logs & Runtime Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# OS and Editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Temporary and local database caches
.cache/
.temp/
*.local
