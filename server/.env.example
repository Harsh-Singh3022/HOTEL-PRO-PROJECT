# ==============================================================================
# HotelPro Server Environment Configuration Template
# DO NOT COMMIT ACTUAL SECRETS OR SENSITIVE PASSWORDS TO VERSION CONTROL
# Copy this file to .env and replace placeholders with your actual secrets.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (KEEP SECRET)
# Replace with your actual MongoDB Atlas or production connection string
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/hotelpro?retryWrites=true&w=majority
MONGO_URI=your_mongodb_connection_string_here
USE_MEMORY_DB=false

# Authentication & Cryptographic Keys (KEEP SECRET - HIGH RISK)
# Must be a long, cryptographically random string (e.g., openssl rand -base64 64)
JWT_SECRET=your_super_secret_jwt_signing_key_here
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=10

# Security & CORS Settings
CLIENT_URL=http://localhost:5173

# Business Rules & Billing
TAX_PERCENT=12
